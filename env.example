# Google OAuth 2.0 credentials
# Get these from https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URIs in Google Console:
#    - Local:  http://127.0.0.1:8000/accounts/google/login/callback/
#    - Heroku: https://YOUR-APP-NAME.herokuapp.com/accounts/google/login/callback/
GOOGLE_OAUTH2_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-client-secret

# Optional: for local .env (python-dotenv)
# DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=your-dev-secret-key

# --- Heroku config vars (set in Heroku Dashboard or CLI) ---
# GOOGLE_OAUTH2_CLIENT_ID=...
# GOOGLE_OAUTH2_CLIENT_SECRET=...
# DJANGO_SECRET_KEY=...   (required in production; use a random 50+ char string)
# DJANGO_DEBUG=False      (required in production)
# ALLOWED_HOSTS=your-app.herokuapp.com,localhost,127.0.0.1

# Amazon S3 storage (for file/image uploads)
# Create an S3 bucket and IAM user at https://console.aws.amazon.com/
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1
